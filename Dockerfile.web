# Frontend Dockerfile - Multi-stage build
FROM node:22.13-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.33.0

# Accept build arguments for authentication
ARG GITHUB_TOKEN
ARG NPM_TOKEN

# Copy .npmrc with token support
COPY .npmrc .npmrc.template ./
RUN if [ -n "$GITHUB_TOKEN" ]; then \
      sed "s/\${GITHUB_TOKEN}/$GITHUB_TOKEN/g; s/\${NPM_TOKEN}/$NPM_TOKEN/g" .npmrc.template > .npmrc && \
      npm config set //npm.pkg.github.com/:_authToken=$GITHUB_TOKEN; \
    fi

# Copy workspace configuration
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy source
COPY artifacts/website365 ./artifacts/website365
COPY tsconfig.* ./

# Install dependencies with proper network settings
RUN pnpm install --frozen-lockfile --fetch-timeout=60000

# Build
WORKDIR /app/artifacts/website365
RUN pnpm run build

# Production stage
FROM node:22.13-alpine

# Install curl for health checks
RUN apk add --no-cache curl

WORKDIR /app

# Install serve to run the static files
RUN npm install -g serve

# Copy built files from builder
COPY --from=builder /app/artifacts/website365/dist ./dist

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start serving static files
CMD ["serve", "-s", "dist", "-l", "3000"]
