FROM node:20-alpine AS builder

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

ARG GITHUB_TOKEN
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./

# Copy all workspaces
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build everything
RUN pnpm --filter ./artifacts/website365 run build
RUN pnpm --filter ./artifacts/api-server run build

# --- Runner Stage ---
FROM node:20-alpine AS runner

WORKDIR /app

ARG GITHUB_TOKEN
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./

# Copy all workspaces packages.json to install prod deps
COPY lib ./lib
COPY scripts ./scripts
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/website365/package.json ./artifacts/website365/
COPY artifacts/api-server/build.mjs ./artifacts/api-server/

# Install ONLY production dependencies
RUN pnpm install --prod --frozen-lockfile

# Copy built backend files
COPY --from=builder /app/artifacts/api-server/dist ./artifacts/api-server/dist

# Copy built frontend files into the backend's 'public' folder
COPY --from=builder /app/artifacts/website365/dist/public ./artifacts/api-server/public

# Set working directory to the API server
WORKDIR /app/artifacts/api-server

# Health check
RUN apk add --no-cache curl
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/api/healthz || exit 1

EXPOSE 3001

# Start the server
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
