# Coolify-specific Dockerfile for Web Frontend
# This builds the frontend as a standalone service served by nginx

FROM node:22.13-alpine as builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.33.0

# Accept build arguments for authentication
ARG GITHUB_TOKEN
ARG NPM_TOKEN

# Copy npmrc if it exists
COPY .npmrc* ./

# Copy configuration files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY tsconfig.* ./

# Copy libraries and frontend source
COPY lib ./lib
COPY artifacts/website365 ./artifacts/website365

# Install dependencies with proper network settings
RUN pnpm install --frozen-lockfile --fetch-timeout=60000

# Build frontend
WORKDIR /app/artifacts/website365
RUN pnpm run build

# Production stage - nginx
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

WORKDIR /usr/share/nginx/html

# Copy built frontend
COPY --from=builder /app/artifacts/website365/dist/public .

# Copy nginx configuration as a template for envsubst
COPY nginx.web.conf /etc/nginx/templates/default.conf.template

# Set default backend host (matches service name and port in docker-compose.yml)
# Using 'api:3001' as the internal default
ENV BACKEND_HOST=api:3001

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
