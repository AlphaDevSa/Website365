# API Server Dockerfile
FROM node:22.13-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.33.0

# Accept build arguments for authentication
ARG GITHUB_TOKEN
ARG NPM_TOKEN

# Copy .npmrc with token support
COPY .npmrc .npmrc.template ./
RUN if [ -n "$GITHUB_TOKEN" ]; then \
      sed "s/\${GITHUB_TOKEN}/$GITHUB_TOKEN/g; s/\${NPM_TOKEN}/$NPM_TOKEN/g" .npmrc.template > .npmrc && \
      npm config set //npm.pkg.github.com/:_authToken=$GITHUB_TOKEN; \
    fi

# Copy workspace configuration
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy library dependencies
COPY lib ./lib
COPY artifacts/api-server ./artifacts/api-server

# Install dependencies with proper network settings
RUN pnpm install --frozen-lockfile --fetch-timeout=60000

# Build the application
WORKDIR /app/artifacts/api-server
RUN pnpm run build

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/healthz', (r) => {if (r.statusCode !== 404) process.exit(0); process.exit(1);})"

# Start the server
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
